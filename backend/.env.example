# Copy to backend/.env and replace placeholders. Never commit backend/.env.
# Aiven Console > PostgreSQL service > connection information
AIVEN_PG_HOST=your-service-host.aivencloud.com
AIVEN_PG_PORT=your-aiven-port
AIVEN_PG_DATABASE=defaultdb
AIVEN_PG_USER=avnadmin
AIVEN_PG_PASSWORD=replace-with-your-aiven-password

# Optional alternative full JDBC URL:
# DATABASE_URL=jdbc:postgresql://your-service-host.aivencloud.com:your-aiven-port/defaultdb?sslmode=require

SERVER_PORT=4040
# Exact frontend origins, comma-separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
